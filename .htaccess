# Cache control para HTML, CSS y JS — fuerza revalidación en cada visita
<FilesMatch "\.(html|css|js)$">
  Header set Cache-Control "no-cache, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Imágenes y fuentes — caché larga (no cambian frecuentemente)
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf)$">
  Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
