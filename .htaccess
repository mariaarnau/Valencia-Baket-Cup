# Forzar HTTPS y dominio canónico sin www (301)
RewriteEngine On
# 1) www -> sin www
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://valenciabasketcup.com%{REQUEST_URI} [L,R=301]

# 2) HTTP -> HTTPS (respeta proxy/CDN que ya sirve HTTPS para evitar bucles)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://valenciabasketcup.com%{REQUEST_URI} [L,R=301]

# Bloquear config.php
<Files "config.php">
  Require all denied
</Files>

# Cache control para HTML, CSS y JS — fuerza revalidación en cada visita
<FilesMatch "\.(html|css|js)$">
  Header set Cache-Control "no-cache, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Imágenes y fuentes — caché larga (no cambian frecuentemente)
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf)$">
  Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
